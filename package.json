{
  "name": "react-weather-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "express": "5.2.1",
    "react": "^18.2.0",
    "react-accessible-accordion": "^5.0.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "react-select-async-paginate": "^0.7.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "server": "node --env-file-if-exists=.env server/index.cjs",
    "serve": "node --env-file-if-exists=.env server/index.cjs",
    "demo": "node server/index.cjs --demo",
    "test:server": "node --test server/test/*.test.cjs",
    "test:ui": "react-scripts test --watchAll=false --runInBand",
    "check": "npm run test:server && npm run test:ui && npm run build",
    "benchmark": "node server/benchmark.cjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "proxy": "http://127.0.0.1:3001"
}
